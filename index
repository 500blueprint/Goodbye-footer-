<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Moonlight Designs Footer</title>

<style>

/* ================================================
   🌙 MOONLIGHT DESIGNS
   STELLA + LUNA GOODBYE FOOTER
================================================ */

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;

  width: 100%;

  background: transparent;

  overflow-x: hidden;

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


/* ================================================
   🌌 FOOTER
================================================ */

.moonlight-footer {

  position: relative;

  width: 100%;

  min-height: 600px;

  overflow: hidden;

  text-align: center;

  color: white;

  padding:

    55px
    20px
    25px;

  background:

    radial-gradient(
      circle at 50% 15%,
      rgba(157,110,255,.35),
      transparent 35%
    ),

    radial-gradient(
      circle at 15% 70%,
      rgba(80,150,255,.18),
      transparent 35%
    ),

    radial-gradient(
      circle at 85% 70%,
      rgba(190,100,255,.16),
      transparent 35%
    ),

    linear-gradient(
      180deg,
      #111b43 0%,
      #16153f 45%,
      #080d26 100%
    );

}


/* ================================================
   🌙 MOON GLOW
================================================ */

.moon {

  position: absolute;

  width: 130px;
  height: 130px;

  border-radius: 50%;

  right: 8%;
  top: 55px;

  background:

    radial-gradient(
      circle at 35% 35%,
      #ffffff,
      #e9e0ff 45%,
      #bba5ff 75%,
      #9278e8
    );

  box-shadow:

    0 0 20px white,

    0 0 50px
    rgba(210,190,255,.8),

    0 0 90px
    rgba(150,170,255,.55);

  opacity: .85;

  animation:
    moonGlow
    3s
    ease-in-out
    infinite alternate;

}


@keyframes moonGlow {

  from {

    box-shadow:

      0 0 15px white,

      0 0 40px
      rgba(210,190,255,.65);

  }

  to {

    box-shadow:

      0 0 25px white,

      0 0 70px
      rgba(210,190,255,.9),

      0 0 110px
      rgba(130,170,255,.6);

  }

}


/* ================================================
   ✨ TEXT
================================================ */

.footer-title {

  position: relative;

  z-index: 10;

  margin: 0;

  font-size:

    clamp(
      30px,
      6vw,
      52px
    );

  font-weight: 800;

  text-shadow:

    0 0 10px
    rgba(255,255,255,.5),

    0 0 20px
    rgba(190,150,255,.5);

}


.footer-message {

  position: relative;

  z-index: 10;

  margin:

    12px
    auto
    35px;

  max-width: 650px;

  font-size:

    clamp(
      15px,
      3vw,
      19px
    );

  line-height: 1.6;

  color: #e8e1ff;

}


/* ================================================
   🦉 🐈 CHARACTERS
================================================ */

.characters {

  position: relative;

  z-index: 5;

  display: flex;

  justify-content: center;

  align-items: flex-end;

  gap:

    clamp(
      20px,
      7vw,
      100px
    );

  width: 100%;

  max-width: 850px;

  margin:

    90px
    auto
    15px;

}


/* ================================================
   CHARACTER WRAPPER
================================================ */

.character {

  position: relative;

  width:

    min(
      300px,
      38vw
    );

}


/* ================================================
   CHARACTER PNG
================================================ */

.character img {

  display: block;

  width: 100%;

  height: auto;

  transform-origin:
    center bottom;

  filter:

    drop-shadow(
      0 0 6px
      rgba(255,255,255,.45)
    )

    drop-shadow(
      0 0 16px
      rgba(175,130,255,.5)
    )

    drop-shadow(
      0 0 26px
      rgba(90,160,255,.3)
    );

}


/* ================================================
   🦉 STELLA ANIMATION
================================================ */

.stella img {

  animation:

    stellaWave
    2.1s
    ease-in-out
    infinite;

}


@keyframes stellaWave {

  0% {

    transform:
      translateY(0)
      rotate(-2deg);

  }

  25% {

    transform:
      translateY(-7px)
      rotate(3deg);

  }

  50% {

    transform:
      translateY(0)
      rotate(-1deg);

  }

  75% {

    transform:
      translateY(-5px)
      rotate(4deg);

  }

  100% {

    transform:
      translateY(0)
      rotate(-2deg);

  }

}


/* ================================================
   🐈‍⬛ LUNA ANIMATION
================================================ */

.luna img {

  animation:

    lunaWave
    2.5s
    ease-in-out
    infinite;

}


@keyframes lunaWave {

  0% {

    transform:
      translateY(0)
      rotate(2deg);

  }

  25% {

    transform:
      translateY(-5px)
      rotate(-3deg);

  }

  50% {

    transform:
      translateY(-2px)
      rotate(2deg);

  }

  75% {

    transform:
      translateY(-8px)
      rotate(-4deg);

  }

  100% {

    transform:
      translateY(0)
      rotate(2deg);

  }

}


/* ================================================
   💬 SPEECH BUBBLES
================================================ */

.speech {

  position: absolute;

  z-index: 20;

  top: -30px;

  left: 50%;

  transform:

    translate(
      -50%,
      -100%
    );

  width:
    max-content;

  max-width: 220px;

  padding:

    12px
    18px;

  border-radius: 20px;

  background:

    rgba(
      255,
      255,
      255,
      .96
    );

  color: #25154d;

  font-size: 14px;

  font-weight: 800;

  box-shadow:

    0 0 12px
    rgba(255,255,255,.5),

    0 0 25px
    rgba(190,150,255,.55);

  animation:

    bubbleFloat
    2.4s
    ease-in-out
    infinite;

}


.speech::after {

  content: "";

  position: absolute;

  left: 50%;

  bottom: -10px;

  transform:
    translateX(-50%);

  border-left:
    10px solid transparent;

  border-right:
    10px solid transparent;

  border-top:
    11px solid white;

}


@keyframes bubbleFloat {

  0%,
  100% {

    transform:

      translate(
        -50%,
        -100%
      )

      translateY(0);

  }

  50% {

    transform:

      translate(
        -50%,
        -100%
      )

      translateY(-6px);

  }

}


/* ================================================
   ✨ STARS
================================================ */

.star {

  position: absolute;

  z-index: 2;

  pointer-events: none;

  color: white;

  opacity: 0;

  text-shadow:

    0 0 5px white,

    0 0 12px #d5baff,

    0 0 20px #9fcfff;

  animation:

    starFall
    linear
    forwards;

}


@keyframes starFall {

  0% {

    transform:

      translateY(-30px)

      rotate(0deg);

    opacity: 0;

  }

  15% {

    opacity: .9;

  }

  85% {

    opacity: .8;

  }

  100% {

    transform:

      translateY(650px)

      rotate(180deg);

    opacity: 0;

  }

}


/* ================================================
   ✨ SPARKLES AROUND CHARACTERS
================================================ */

.sparkle {

  position: absolute;

  pointer-events: none;

  font-size: 18px;

  animation:

    sparkle
    1.5s
    ease-in-out
    infinite alternate;

}


.sparkle1 {

  left: 8%;

  top: 40%;

}


.sparkle2 {

  right: 10%;

  top: 52%;

  animation-delay: .5s;

}


.sparkle3 {

  left: 47%;

  top: 48%;

  animation-delay: 1s;

}


@keyframes sparkle {

  from {

    opacity: .2;

    transform:
      scale(.7)
      rotate(0deg);

  }

  to {

    opacity: 1;

    transform:
      scale(1.35)
      rotate(30deg);

  }

}


/* ================================================
   🌙 FOOTER LINKS
================================================ */

.footer-links {

  position: relative;

  z-index: 10;

  display: flex;

  justify-content: center;

  flex-wrap: wrap;

  gap:

    12px
    25px;

  margin:

    35px
    auto
    20px;

}


.footer-links a {

  color: #ddd3ff;

  text-decoration: none;

  font-size: 14px;

  font-weight: 700;

  transition: .25s;

}


.footer-links a:hover {

  color: white;

  text-shadow:

    0 0 8px white,

    0 0 15px #bd9aff;

}


/* ================================================
   COPYRIGHT
================================================ */

.copyright {

  position: relative;

  z-index: 10;

  margin-top: 20px;

  font-size: 12px;

  line-height: 1.7;

  color:

    rgba(
      255,
      255,
      255,
      .6
    );

}


/* ================================================
   📱 MOBILE
================================================ */

@media
(max-width: 600px) {

  .moonlight-footer {

    min-height: 520px;

    padding:

      45px
      10px
      20px;

  }


  .moon {

    width: 80px;

    height: 80px;

    right: 5%;

    top: 35px;

  }


  .characters {

    gap: 10px;

    margin-top: 100px;

  }


  .character {

    width: 44vw;

  }


  .speech {

    font-size: 11px;

    padding:

      9px
      11px;

    max-width: 145px;

  }


  .footer-links {

    gap:

      10px
      18px;

  }

}

</style>

</head>


<body>


<footer class="moonlight-footer">


<!-- 🌙 MOON -->

<div class="moon"></div>


<!-- ✨ DECORATIVE SPARKLES -->

<div class="sparkle sparkle1">
  ✦
</div>

<div class="sparkle sparkle2">
  ✧
</div>

<div class="sparkle sparkle3">
  ✦
</div>



<!-- 🌙 GOODBYE MESSAGE -->

<h2 class="footer-title">

  Thanks for stopping by! ✨

</h2>


<p class="footer-message">

  Come back soon — there's always
  more magic being made at
  Moonlight Designs.

</p>



<!-- 🦉🐈‍⬛ CHARACTERS -->

<div class="characters">


  <!-- 🦉 STELLA -->

  <div class="character stella">


    <div class="speech">

      Thanks for visiting! ✨

    </div>


    <img
      src="stella.png"
      alt="Stella">


  </div>



  <!-- 🐈‍⬛ LUNA -->

  <div class="character luna">


    <div class="speech">

      Come back soon! 🌙

    </div>


    <img
      src="luna.png"
      alt="Luna">


  </div>


</div>



<!-- 🌙 NAVIGATION -->

<div class="footer-links">


  <a
    href="YOUR-HOME-LINK"
    target="_top">

    Home

  </a>


  <a
    href="YOUR-SHOP-LINK"
    target="_top">

    Shop

  </a>


  <a
    href="YOUR-ABOUT-LINK"
    target="_top">

    About Me

  </a>


  <a
    href="https://payhip.com/MoonlightDesigns87/collection/luna-s-freebies"
    target="_top">

    Freebies

  </a>


  <a
    href="YOUR-CONTACT-LINK"
    target="_top">

    Contact Me

  </a>


</div>



<!-- COPYRIGHT -->

<div class="copyright">

  © 2026 Moonlight Designs

  <br>

  Turning Ideas Into Beautiful Creations ✨

</div>


</footer>



<script>

/* ================================================
   ✨ FALLING STARS + MOONS
================================================ */

const footer =
document.querySelector(
  ".moonlight-footer"
);


const symbols = [

  "✦",
  "✧",
  "⋆",
  "★",
  "☾"

];


function createStar() {


  const star =
  document.createElement(
    "span"
  );


  star.className =
  "star";


  star.innerText =

  symbols[

    Math.floor(

      Math.random()
      *
      symbols.length

    )

  ];


  star.style.left =

  Math.random()
  *
  100
  +
  "%";


  star.style.top =
  "-20px";


  star.style.fontSize =

  (
    8
    +
    Math.random()
    *
    14
  )

  +
  "px";


  star.style.animationDuration =

  (
    6
    +
    Math.random()
    *
    6
  )

  +
  "s";


  footer.appendChild(
    star
  );


  setTimeout(

    function() {

      star.remove();

    },

    13000

  );

}


/* Create stars */

setInterval(

  createStar,

  600

);


/* Start immediately */

for (

  let i = 0;

  i < 12;

  i++

) {

  setTimeout(

    createStar,

    i * 150

  );

}

</script>


</body>

</html>
